---
import Layout from '../layouts/Layout.astro';
---

<Layout>
    <script>
      const default_sentences =
      `
      Tu t’entends bien avec ta famille? (Pourquoi / Pourquoi pas
      Comment est ta personnalité? Tu es comment?
      Et tes amis, ils sont comment?
      Et ta famille, elle est comment?
      Qu’est-ce que tu as fait avec tes amis le week-end dernier?
      Que vas-tu faire avec tes amis le week-end prochain?
      Qu’est-ce que tu penses du mariage? Tu te marieras à l’avenir?

      Qu'est-ce que tu manges et bois normalement?
      As-tu un mode de vie sain? Pourquoi?
      Quels seront tes projets pour rester en forme à l'avenir?
      Parle-moi de ton programme sportif de la semaine derniere.
      Le sport, c’est important pour toi?
      Si tu avais plus de temps, que ferais-tu pour améliorer ta santé?

      Quelles matières étudies-tu?
      Quelle est ta matière préférée? Pourquoi?
      Qu'est-ce que tu penses des règles scolaires?
      Comment serait ton école idéale?
      Si tu étais le directeur dans ton collège, qu’est-ce que tu ferais pour l’améliorer?
      Qu’est-ce que tu vas faire après les examens?
      Qu’est-ce que tu vas faire l’année prochaine?
      Voudrais-tu aller à l’université? Pourquoi?
      Quel métier voudrais-tu faire et pourquoi?
      Quand tu étais petit, tu voulais faire quoi comme métier?
      Est-ce que tu as fait un stage?
      Est-ce que tu voudrais faire un stage?

      Qu'est-ce que tu aimes comme films? Pourquoi?
      Qu'est-ce que tu aimes comme émissions télé? Pourquoi?
      Qu'est-ce que tu aimes comme musique? Pourquoi?
      Qu'est-ce que tu vas regarder le week-end prochain?
      Qu'est-ce que tu vas écouter le week-end prochain?
      Décris un voyage récent que tu as fait.
      Quels sports tu faisais quand tu étais jeune?
      Quels sports tu as déjà essayé?
      Tu aimes faire des sports extrêmes? pourquoi/pourquoi pas?

      Quel est ta fête préférée et pourquoi?
      Comment as-tu célébré ce jour, l'année dernière ? C'était comment?
      Comment vas-tu fêter ton prochain anniversaire?
      Aimerais-tu aller à un festival de musique? pourquoi/pourquoi pas?

      Quels conseils donnerais-tu pour devenir célèbre?
      Quels sont les avantages et les inconvénients d'être célèbre?
      Tu ferais quoi pour être célèbre?
      Parle-moi d'une célébrité francophone.
      Est-ce que tu voulais être célèbre quand tu étais petit?
      Tu veux être célèbre? Pourquoi / Pourquoi pas?

      Où vas-tu en vacances normalement?
      Qu’est-ce que tu aimes faire en vacances?
      Où es-tu allé en vacances l’été dernier?
      Si tu avais le choix, où voudrais-tu passer tes vacances?
      Ou habitais-tu quand tu étais petit?
      Voudrais-tu prendre une année sabbatique? pourquoi/pourquoi pas?

      Comment utilises-tu Internet d'habitude?
      Utiliseras-tu les réseaux sociaux ce soir?
      Utiliseras-tu les réseaux sociaux ce week-end?
      Es-tu pour ou contre les réseaux sociaux? Pourquoi?
      Quand tu étais petit, passais-tu beaucoup de temps sur Internet?
      As-tu utilisé les réseaux sociaux récemment?

      Qu'est-ce que tu fais pour aider l'environnement?
      Qu'est-ce qu'on pourrait faire pour aider l'environnement?
      Quels sont les problèmes environnementaux principaux?
      Quel est le plus grand problème de l’environnement dans ta ville?
      Comment est ta ville? Tu aimes ta ville?
      Qu’est-ce qu’il y a pour les jeunes?
      Qu’est-ce qu’il y a pour les touristes?
      Comment serait ta maison?
      Comment serait ta ville idéale?
      Si tu étais riche, où voudrais-tu habiter?
      Qu'est-ce que tu as fait chez toi hier soir?
      `;
      const synth = window.speechSynthesis;
      const sentences = document.querySelector("#sentences");
      const sentenceSubmit = document.querySelector("#sentenceSubmit");
      const defaultSubmit = document.querySelector("#defaultSubmit");
      const warningBox = document.querySelector("#warningBox");

      const defaultPitch = 1;
      const defaultRate = 1;

      function getBestVoice() {
        const availableVoices = synth.getVoices();

        var bestVoice;
        var bestVoiceScore = 0;

        for (const voice of availableVoices) {
          var voiceScore = 0;
          if (voice.lang == "fr_FR") {
            voiceScore += 10
          };
          if (voice.default) {
            voiceScore += 1
          };

          if (voiceScore >= bestVoiceScore) {
            bestVoice = voice;
            bestVoiceScore = voiceScore;
          };
        };
        return bestVoice
      }

      function getRandomSentence() {
        const possibleSentences = sentences.value.split("\n").flat();
        const randomSentence = possibleSentences[Math.floor(Math.random() * possibleSentences.length)];
        return randomSentence;
      }

      /* fetch  */
      sentenceSubmit.addEventListener("click", function (e) {
        sentenceSubmit.disabled = true;
        const sentenceSpeak = new SpeechSynthesisUtterance(getRandomSentence());
        const voice = getBestVoice();
        if (voice == "0" || voice === undefined) {
          console.error("No speech synthesis voices found.")
          warningBox.textContent = "No speech synthesis voices found.";
          warningBox.style.color = "#ff4545";
          return
        } else if (voice.lang != "fr_FR") {
          console.warning("No French speech synthesis voices found.");
          warningBox.textContent = "No speech synthesis voices found.";
          warningBox.style.color = "#ffd800";
        } else {
          warningBox.textContent = "Speaking...";
          warningBox.style.color = "#95a922";
        };
        sentenceSpeak.voice = voice;
        sentenceSpeak.pitch = defaultPitch;
        sentenceSpeak.rate = defaultRate;
        synth.speak(sentenceSpeak);
        sentenceSpeak.onend = () => {
          sentenceSubmit.disabled = false;
          warningBox.textContent = "Finished speaking.";
          warningBox.style.color = "#95a922";
        };
      });
      defaultSubmit.addEventListener("click", function (e) {
        sentences.value = default_sentences;
        warningBox.textContent = "Filled default French sentences.";
        warningBox.style.color = "#95a922";
      });
    </script>

    <div id="main">
        <div id="title">
            <h1 strong id="titleHeading">Vociferate</h1>
        </div>
        <div id="inputArea">
            <div id="sentenceArea">
                <p>Sentences:</p>
                <textarea rows=10 cols=100 id="sentences"></textarea>
            </div>
            <div id="submitArea">
                <button id="sentenceSubmit" class="button">Speak</button>
                <p>&emsp;</p>
                <button id="defaultSubmit" class="button">Default Sentences</button>
                <p>&emsp;</p>
                <p id="warningBox"></p>
            </div>
        </div>
    </div>
</Layout>

<style>
p, button, textarea {
    font-family: Verdana, Tahoma, Helvetica, Arial, sans-serif;
}

p {
    color: white;
}

body {
    display: flex;
    justify-content: center;
    align-items: center;
}

#main {
    display: flex;
    justify-content: center;
    align-items: center;
    flex-direction: column;
    flex-wrap: wrap;
    width: fit-content;
}

#inputArea {
    border: 2px solid rgba(155, 141, 247, 1);
    padding: 1em;
    border-radius: 1em;
}

#submitArea {
    margin: 1em;
    display: flex;
    flex-direction: row;
    flex-wrap: nowrap;
}

#titleHeading {
    background: linear-gradient(90deg,rgba(155, 141, 247, 1) 25%, rgba(184, 92, 255, 1) 75%);
    background-clip: text;
    -webkit-background-clip: text;
    color: transparent;
    font-size: 10em;
    padding: 0px;
    margin: 0px;
}

.button {
    cursor: pointer;
    padding: .8em 1.2em;
    border: 2px solid;
    border-radius: 2em;
    text-align: centre;
    background-image: linear-gradient(90deg,rgba(155, 141, 247, 1) 25%, rgba(184, 92, 255, 1) 75%);
    color: white;
    font-size: inherit;
}

</style>
